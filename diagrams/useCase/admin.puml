@startuml UseCase_Acteur_Admin
left to right direction
skinparam packageStyle rectangle

actor "Administrateur" as Admin

package "Auth Service" {
  usecase "Se connecter" as UC1
  usecase "Consulter la liste des utilisateurs" as UC2
  usecase "Désactiver un compte\n(Client ou Prestataire)" as UC3
}

package "Booking Service" {
  usecase "Consulter toutes les réservations" as UC4
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4

UC3 ..> UC2 : <<include>>

